<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The hardened runtime's exceptions Image Triage needs when it is signed with a Developer ID (packaging/build_macos.sh), for notarization:
  - the frozen Python and ONNX Runtime generate code at run time (JIT, writable-executable memory);
  - the managed AI runtime is installed later from PyPI wheels (packaging/ai_runtime_locks), whose libraries are signed by their own
    developers, not by this app's identity: library validation would refuse to load them into the app's Python (ai_python_runner).
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
