[package]
name = "image-triage-raw-preview"
version = "0.1.0"
edition = "2024"
publish = false

[workspace]

[[bin]]
name = "image-triage-raw-preview"
path = "@SOURCE@/main.rs"

[dependencies]
photocraft-io = { path = "@PHOTOCRAFT@/crates/io" }
photocraft-codecs = { path = "@PHOTOCRAFT@/crates/codecs" }
photocraft-raw = { path = "@PHOTOCRAFT@/crates/raw" }
photocraft-algo = { path = "@PHOTOCRAFT@/crates/algo" }
photocraft-cms = { path = "@PHOTOCRAFT@/crates/cms" }
photocraft-doc = { path = "@PHOTOCRAFT@/crates/doc" }
photocraft-gpu = { path = "@PHOTOCRAFT@/crates/gpu" }
serde_json = "1"
pollster = "1"
rayon = "1"

# One GPU backend per platform (main.rs `Gpu::new`): the worker has no window, so only the platform's compute API is built in.
[target.'cfg(windows)'.dependencies]
wgpu = { version = "30", default-features = false, features = ["std", "wgsl", "dx12"] }

[target.'cfg(target_os = "macos")'.dependencies]
wgpu = { version = "30", default-features = false, features = ["std", "wgsl", "metal"] }

[target.'cfg(not(any(windows, target_os = "macos")))'.dependencies]
wgpu = { version = "30", default-features = false, features = ["std", "wgsl", "vulkan"] }

[profile.dev]
opt-level = 1
debug = "line-tables-only"

[profile.dev.package."*"]
opt-level = 2
debug = false
