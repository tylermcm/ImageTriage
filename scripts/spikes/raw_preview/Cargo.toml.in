[package]
name = "triage-raw-preview-spike"
version = "0.1.0"
edition = "2024"
publish = false

[workspace]

[[bin]]
name = "triage-raw-preview-spike"
path = "@SOURCE@/main.rs"

[dependencies]
photocraft-io = { path = "@PHOTOCRAFT@/crates/io" }
photocraft-algo = { path = "@PHOTOCRAFT@/crates/algo" }
photocraft-cms = { path = "@PHOTOCRAFT@/crates/cms" }
photocraft-doc = { path = "@PHOTOCRAFT@/crates/doc" }
photocraft-gpu = { path = "@PHOTOCRAFT@/crates/gpu" }
serde_json = "1"
wgpu = { version = "30", default-features = false, features = ["std", "wgsl", "dx12"] }
pollster = "1"
rayon = "1"

[profile.dev]
opt-level = 1
debug = "line-tables-only"

[profile.dev.package."*"]
opt-level = 2
debug = false
